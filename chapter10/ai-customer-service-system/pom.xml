    -->
    <groupId>com.example.aicustomerservice</groupId>
    <artifactId>ai-customer-service-system-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ai-customer-service-system-parent</name>

    <modules>
        <module>backend</module>
    </modules>
</project>
